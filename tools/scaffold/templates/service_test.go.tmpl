package service_test

import (
	"context"
	"testing"

	"{{.AdaptersImport}}"
	"{{.ServiceImport}}"
)

func TestServiceCreateAndList(t *testing.T) {
	tests := []struct {
		name  string
		names []string
	}{
		{name: "single item", names: []string{"example"}},
		{name: "multiple items", names: []string{"first", "second"}},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			svc := service.New(adapters.NewInMemoryRepository())
			ctx := context.Background()

			createdIDs := make(map[string]string, len(tt.names))
			for _, name := range tt.names {
				created, err := svc.Create{{.TypeName}}(ctx, name)
				if err != nil {
					t.Fatalf("Create{{.TypeName}}(%q): %v", name, err)
				}
				if created.Name != name {
					t.Errorf("Create{{.TypeName}}(%q): Name = %q, want %q", name, created.Name, name)
				}
				createdIDs[created.ID] = name
			}

			items, err := svc.List{{.TypeName}}s(ctx)
			if err != nil {
				t.Fatalf("List{{.TypeName}}s: %v", err)
			}
			if len(items) != len(tt.names) {
				t.Fatalf("List{{.TypeName}}s: got %d items (%+v), want %d", len(items), items, len(tt.names))
			}
			for _, item := range items {
				if name, ok := createdIDs[item.ID]; !ok || item.Name != name {
					t.Errorf("List{{.TypeName}}s: unexpected item %+v, want one of %v", item, createdIDs)
				}
			}
		})
	}
}
